# LLM (Ollama)
LLM_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store
VECTOR_DATABASE=faiss
VECTOR_DATABASE_URL=data/indexes/faiss
VECTOR_DATABASE_PATH=data/indexes/faiss

# Retrieval
TOP_K=3
RETRIEVAL_THRESHOLD=0.25
RETRIEVER_BACKEND=bm25

# Data
SAMSUNG_MANUAL_SOURCE=https://www.samsung.com/au/support/model/UA75DU8000WXXY/
DEFAULT_TV_MODEL=UA75DU8000WXXY
MANUAL_MANIFEST_DIR=data/manifests
MANUAL_TEXT_DIR=data/manuals
COLLECTION_PATH=data/collection.csv
METADATA_PATH=data/indexes/faiss/metadata.json

# API / demo
API_PORT=8000
API_HOST=0.0.0.0
